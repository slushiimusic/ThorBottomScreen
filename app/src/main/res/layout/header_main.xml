<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingLeft="20dp"
    android:paddingRight="20dp"
    android:paddingTop="20dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/app_name"
        android:textSize="26sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/status_line"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textSize="14sp" />

    <!-- Setup: only visible until the two permissions are granted. -->
    <LinearLayout
        android:id="@+id/setup_box"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="?android:attr/colorBackgroundFloating"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/setup_title"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/perm_write_state"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btn_write_settings"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/grant_write_settings" />

        <TextView
            android:id="@+id/perm_overlay_state"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btn_overlay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/grant_overlay" />

        <TextView
            android:id="@+id/perm_a11y_state"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btn_accessibility"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/grant_accessibility" />
    </LinearLayout>

    <Switch
        android:id="@+id/sw_enabled"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:text="@string/opt_enabled"
        android:textSize="16sp" />

    <Switch
        android:id="@+id/sw_restore"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="@string/opt_restore"
        android:textSize="16sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/opt_restore_hint"
        android:textSize="12sp" />

    <Switch
        android:id="@+id/sw_override"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="@string/opt_override"
        android:textSize="16sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:text="@string/opt_override_hint"
        android:textSize="12sp" />

    <Switch
        android:id="@+id/sw_focus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/opt_focus"
        android:textSize="16sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/opt_focus_hint"
        android:textSize="12sp" />

    <Switch
        android:id="@+id/sw_deep"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="@string/opt_deep"
        android:textSize="16sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/opt_deep_hint"
        android:textSize="12sp" />

    <Switch
        android:id="@+id/sw_rotation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="@string/opt_rotation"
        android:textSize="16sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/opt_rotation_hint"
        android:textSize="12sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_weight="1"
            android:text="@string/apps_title"
            android:textSize="18sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_select_emulators"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/select_emulators"
            android:textSize="12sp" />
    </LinearLayout>

    <EditText
        android:id="@+id/search"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:hint="@string/search_hint"
        android:importantForAutofill="no"
        android:inputType="text"
        android:maxLines="1" />
</LinearLayout>
